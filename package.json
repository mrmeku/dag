{
  "name": "dag",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ci": "node packages/dagworkflows/src/cli.ts run scripts/ci.ts",
    "release": "node packages/dagworkflows/src/cli.ts run scripts/release.ts",
    "build:action": "cd packages/dagworkflows && bun run build:action",
    "typecheck": "tsgo --noEmit",
    "lint": "bun --bun eslint .",
    "format": "prettier --write .",
    "docs": "node scripts/docs.ts"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@mrmeku/dagraph": "workspace:*",
    "@mrmeku/dagworkflows": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^24.19.2",
    "@typescript/native-preview": "^7.0.0-dev.20260131.1",
    "commander": "^14.0.3",
    "eslint": "^10.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rollup": "^4.64.7",
    "rollup-plugin-dts": "^6.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "yaml": "^2.9.1"
  }
}
