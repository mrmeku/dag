{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Strict type checking (strict enables: noImplicitAny, strictNullChecks, strictFunctionTypes, strictBindCallApply, strictPropertyInitialization, noImplicitThis, useUnknownInCatchVariables, alwaysStrict)
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,

    // Additional strict checks
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Code quality
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,

    // Performance
    "skipLibCheck": true,

    // Explicit, so a newer compiler that stops auto-including @types/* still sees them
    "types": ["bun", "node"],

    // Path aliases
    "paths": {
      "@mrmeku/dagraph": ["./packages/dagraph/src/index.ts"],
      "@mrmeku/dagraph/fs": ["./packages/dagraph/src/ports/fs.ts"],
      "@mrmeku/dagraph/fs/node": ["./packages/dagraph/src/ports/node-fs.ts"],
      "@mrmeku/dagraph/mermaid": ["./packages/dagraph/src/mermaid.ts"],
      "@mrmeku/dagworkflows": ["./packages/dagworkflows/src/index.ts"],
      "@mrmeku/dagworkflows/github": ["./packages/dagworkflows/src/ports/github.ts"]
    }
  },
  "exclude": ["node_modules"]
}
